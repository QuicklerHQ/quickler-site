---json
{
  "layout": "layouts/story.njk",
  "permalink": "/pages/all.html",
  "bodyClass": "page-story",
  "hero": {
    "eyebrow": "Index",
    "heading": "Every guide and article.",
    "lede": "Every Quickler guide, template and comparison in one list.",
    "actions": [
      {
        "label": "Guides overview",
        "href": "/pages/guides.html",
        "style": "btn-primary"
      },
      {
        "label": "Support",
        "href": "/pages/help/index.html",
        "style": "btn-secondary"
      }
    ]
  },
  "blocks": [],
  "seo": {
    "title": "All guides and articles | Quickler",
    "description": "Every Quickler guide, template and comparison in one list.",
    "canonical": "https://quickler.co/pages/all.html",
    "lang": "en"
  },
  "scripts": [
    "/js/analytics-events.js"
  ]
}
---
<section class="story-seo" aria-label="All articles">
  <div class="story-seo-inner">
    <h2>All guides and articles</h2>
    <ul class="all-index">
      {%- for a in collections.allArticles %}
      <li><a href="{{ a.url }}">{{ a.title }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>
