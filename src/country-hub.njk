---
pagination:
  data: countries
  size: 1
  alias: country
layout: layouts/story.njk
permalink: "/pages/country-hub-{{ country.slug }}.html"
bodyClass: page-story
eleventyComputed:
  title: "{{ country.title }}"
  hero:
    eyebrow: "Quickler · {{ country.name }}"
    heading: "Quickler for assessors in {{ country.name }}."
    lede: "You walk the site. You answer in WhatsApp. Quickler writes your report. No app to install."
    actions:
      - label: "Try the demo"
        href: "/pages/demo.html"
        style: "btn-primary"
      - label: "Quickler anywhere"
        href: "/pages/global-field-compliance.html"
        style: "btn-secondary"
  seo:
    title: "{{ country.title }}"
    description: "{{ country.description }}"
    keywords: "{{ country.keywords }}"
    author: "Quickler Ltd"
    canonical: "https://quickler.co/pages/country-hub-{{ country.slug }}.html"
    twitterCard: "summary_large_image"
    lang: "en"
    hreflang:
      - lang: "en"
        href: "https://quickler.co/pages/country-hub-{{ country.slug }}.html"
      - lang: "x-default"
        href: "https://quickler.co/pages/global-field-compliance.html"
  scripts:
    - "/js/analytics-events.js"
---
{#- The three country resources rendered as a real .story snap panel (cards),
    so each link is reliably tappable on touch. -#}
<section class="story story-feature">
  <div class="story-inner">
    <p class="story-eyebrow">Resources</p>
    <h2 class="story-h2">Resources for {{ country.name }}.</h2>
    <div class="story-cards" style="--n: {{ 4 if country.careLink else 3 }}">
      {%- if country.careLink %}
      <a class="story-card" href="{{ country.careLink }}"><span class="story-card-kicker">Care and {{ country.careRegulator }}</span><h3>{{ country.careRegulator }} compliance in {{ country.name }}</h3><p>Care home audits. Say what you see in WhatsApp and Quickler writes the report.</p></a>
      {%- endif %}
      <a class="story-card" href="/pages/positioning-{{ country.slug }}.html"><span class="story-card-kicker">Positioning</span><h3>Site reports on WhatsApp in {{ country.name }}</h3><p>How assessors in {{ country.name }} turn a site walk into a report in WhatsApp. No app.</p></a>
      <a class="story-card" href="/pages/data-privacy-{{ country.slug }}.html"><span class="story-card-kicker">Data &amp; privacy</span><h3>Inspection data and privacy in {{ country.name }}</h3><p>How digital Records compare to paper for audit trails in {{ country.name }}.</p></a>
      <a class="story-card" href="/pages/no-app-inspections-{{ country.slug }}.html"><span class="story-card-kicker">Use case</span><h3>No-app site inspections in {{ country.name }}</h3><p>How WhatsApp replaces paper and tablet apps for site safety checks.</p></a>
    </div>
  </div>
</section>
<section class="story story-cta">
  <div class="story-inner">
    <p class="story-eyebrow">Keep exploring</p>
    <h2 class="story-h2">More guides.</h2>
    <p class="story-text story-text-centre">Browse the UK guides, or choose another region.</p>
    <div class="story-actions">
      <a href="/pages/guides.html" class="btn btn-primary">All guides</a>
      <a href="/pages/workflows-regions.html" class="btn btn-secondary">Other regions</a>
    </div>
  </div>
</section>
