---js
{
  layout: "layouts/believe.njk",
  pagination: { data: "beliefs", size: 1, alias: "b" },
  permalink: function (data) { return `/believe/${data.b.n}/index.html`; },
  eleventyComputed: {
    seo: function (data) { return { title: `${data.b.title} | What we believe | Quickler`, description: data.b.text.slice(0, 155), canonical: `https://quickler.co/believe/${data.b.n}/` }; }
  }
}
---
<div class="card site-letter">
  <div class="wf-meta">What we believe · {{ b.n }} of {{ beliefs | length }}</div>
  <h1 class="site-home-h2" style="font-size:2rem;margin-top:8px">{{ b.title }}</h1>
  <p class="site-words" style="font-size:1.15rem !important">{{ b.text }}</p>
  <div class="site-actions" style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <a class="btn-round-add" href="/believe/">All nine</a>
    {%- set nx = pagination.href.next %}{% if nx %}<a class="btn-round-add btn-round-add-primary" href="/believe/{{ beliefs[pagination.pageNumber + 1].n }}/">Next: {{ beliefs[pagination.pageNumber + 1].title }}</a>{% else %}<a class="btn-round-add btn-round-add-primary" href="https://app.quickler.co/signup">Try Quickler free for 14 days</a>{% endif %}
  </div>
</div>
