{#- ============================================================
    THE master template every marketing page uses.

    THE SITE IS THE APP (Philip 5 Nov 2026 08:06 and 08:19: "copy the
    dashboard pages and fit things into that so output is for articles, home
    is for home page, settings for things ... no new code really just use what
    we have", then "do it properly"). Every page is drawn with the web app's
    own stylesheets (/appui/, copied from quickler-dashboard) and the app's own
    markup, so a visitor already knows the app the day they sign up:
      checks   -> Home's "All Checks" panel: each part is a Check tile, open
      settings -> the Settings page: each part is a Settings group, open
      record   -> a Record: title card, the short version as the To do list,
                  each part a section of question rows, the FAQ as the
                  WhatsApp transcript, all open
    A guide (articlePanels) is a Record; pricing, about, help and legal are
    Settings; everything else is Home. A page can set appMode itself.

    Front matter is unchanged: hero { eyebrow, heading, lede, actions,
    actionNote }, blocks [ prose | split | steps | cards | tags | cta | raw |
    video | pricing ], articlePanels, relatedLinks, seoBody, content.
   ============================================================ -#}
{%- set appUi = true %}
{%- set _pl = permalink or '' %}
{%- if appMode %}{% set _mode = appMode %}
{%- elif articlePanels %}{% set _mode = 'record' %}
{%- elif ('pricing' in _pl) or ('about' in _pl) or ('contact' in _pl) or ('/help/' in _pl) or ('faq' in _pl) or ('support' in _pl) or ('plans' in _pl) or ('legal' in _pl) or ('privacy' in _pl) or ('terms' in _pl) or ('cookies' in _pl) or ('dpa' in _pl) %}{% set _mode = 'settings' %}
{%- else %}{% set _mode = 'checks' %}{% endif %}
{%- set _chev %}<svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{% endset %}

{%- macro actionGroup(actions, domain) %}
{%- if actions and actions | length %}
  <div class="wf-bottom-bar site-actions">
    <span></span>
    <div class="wf-action-group" role="group">
    {%- for a in actions %}
      <a class="wf-action-btn{% if loop.first %} site-action-main{% endif %}" href="{{ a.href }}"{% if '//' in a.href and domain not in a.href %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ a.label }}</a>
    {%- endfor %}
    </div>
  </div>
{%- endif %}
{%- endmacro %}

{#- What one block holds, drawn with the app's own pieces: words as words,
    steps and cards as the question rows and Record tiles the app shows,
    tags as the app's round pills, actions as its Edit / Records buttons. -#}
{%- macro blockBody(b, domain) %}
{%- if b.type == "prose" %}
  {%- if b.html %}<div class="site-words">{{ b.html | priceTokens | safe }}</div>{% elif b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
{%- elif b.type == "split" %}
  <p class="site-words">{{ b.text | priceTokens | safe }}</p>
{%- elif b.type == "steps" %}
  {%- if b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
  <div class="wf-q-read">
  {%- for it in b.items %}
    <div class="q-row"><span class="q-label">{{ it.title | safe }}</span><span class="q-type">Step {{ loop.index }}</span></div>
    <p class="site-q-words">{{ it.text | priceTokens | safe }}</p>
  {%- endfor %}
  </div>
{%- elif b.type == "cards" %}
  {%- if b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
  <div class="site-tiles">
  {%- for it in b.items %}
    {%- if it.href %}<a class="rec-tile site-tile" href="{{ it.href }}">{% else %}<div class="rec-tile site-tile">{% endif %}
      <span class="row-main"><span class="row-title">{{ it.title | safe }}</span><span class="row-meta site-tile-words">{{ it.text | priceTokens | safe }}</span></span>
      {%- if it.kicker %}<span class="row-when">{{ it.kicker }}</span>{% endif %}
    {%- if it.href %}</a>{% else %}</div>{% endif %}
  {%- endfor %}
  </div>
{%- elif b.type == "tags" %}
  {%- if b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
  <div class="site-pills">
  {%- for it in b.items %}{% if it.href %}<a class="btn-round-add{% if it.strong %} btn-round-add-primary{% endif %}" href="{{ it.href }}">{{ it.label }}</a>{% else %}<span class="btn-round-add">{{ it.label }}</span>{% endif %}{% endfor %}
  </div>
{%- elif b.type == "cta" %}
  {%- if b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
  {{ actionGroup(b.actions, domain) }}
{%- elif b.type == "raw" %}
  <div class="site-raw">{{ b.html | priceTokens | safe }}</div>
{%- elif b.type == "video" and b.video %}
  {%- if b.text %}<p class="site-words">{{ b.text | priceTokens | safe }}</p>{% endif %}
  <div class="story-video-embed yt-lite{% if b.portrait %} portrait{% endif %}" data-yt="{{ b.video }}" role="button" tabindex="0" aria-label="Play the Quickler walkthrough video">
    {%- if b.portrait %}<img class="yt-lite-thumb" src="https://i.ytimg.com/vi/{{ b.video }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ b.video }}/hqdefault.jpg'" alt="" loading="lazy" width="405" height="720">
    {%- else %}<img class="yt-lite-thumb" src="https://i.ytimg.com/vi/{{ b.video }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">{% endif %}
    <button type="button" class="yt-lite-play" aria-label="Play video"><svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true"><path fill="#f00" d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 .6 34 .6 34 .6S12 .6 7.1 2a8 8 0 0 0-5.6 5.7A83 83 0 0 0 0 24a83 83 0 0 0 1.5 16.3 8 8 0 0 0 5.6 5.7C12 47.4 34 47.4 34 47.4s22 0 26.9-1.4a8 8 0 0 0 5.6-5.7A83 83 0 0 0 68 24a83 83 0 0 0-1.5-16.3z"/><path fill="#fff" d="M27 34l18-10-18-10z"/></svg></button>
  </div>
{%- endif %}
{%- endmacro %}



{#- One Check tile, open. -#}
{%- macro checkTile(title, when, id) %}
<div class="wf-card wf-expanded"{% if id %} id="{{ id }}"{% endif %}>
  <div class="wf-title-row" aria-expanded="true">
    <span class="wf-name-block"><span class="wf-name">{{ title | safe }}</span></span>
    {%- if when %}<span class="wf-activity">{{ when }}</span>{% endif %}
    <svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </div>
  <div class="wf-body">{{ caller() }}</div>
</div>
{%- endmacro %}

{#- One Settings group, open. -#}
{%- macro settingsGroup(title, extra, id) %}
<div class="wfo-group site-group"{% if id %} id="{{ id }}"{% endif %}>
  <div class="wfo-group-head wfo-group-head--fixed" aria-expanded="true">
    <span class="wfo-group-title">{{ title | safe }}</span>
    <span class="wfo-group-extra">{% if extra %}<span class="site-group-label">{{ extra }}</span>{% endif %}<svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
  </div>
  <div class="wfo-group-body">{{ caller() }}</div>
</div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="{{ seo.lang or 'en' }}">
{% include "partials/head.njk" %}
<body class="page-app app-{{ _mode }}">
{% include "partials/nav.njk" %}
<main id="main-content">
<section class="app-section" style="padding-top:28px;">
  <div class="shell-wide{% if _mode != 'checks' %} rec-shell{% endif %}">
{%- set _lead = hero.lede %}
{%- set _ledePanel = false %}{% set _todo = false %}{% set _faq = false %}
{%- for ap in articlePanels or [] %}{% if ap.kind == 'lede' %}{% set _ledePanel = ap %}{% elif ap.kind == 'takeaways' %}{% set _todo = ap %}{% elif ap.kind == 'faq' %}{% set _faq = ap %}{% endif %}{% endfor %}

{%- if _mode == 'checks' %}
{#- ── HOME: the "All Checks" panel (templates/dashboard.html). -#}
<div class="dash-main"><div>
<div class="card" id="wf-section-card" style="padding-bottom:24px;">
  <div class="wf-section-head" style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:0 0 14px;">
    <div class="dash-section-title" style="flex:0 1 auto;min-width:0;font-weight:400;line-height:1.1;color:var(--ink);">{{ hero.eyebrow or 'Quickler' }}</div>
    <div class="wf-section-actions" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0;justify-content:flex-end;">
      {%- for a in hero.actions or [] %}<a href="{{ a.href }}" class="btn-round-add{% if loop.first %} btn-round-add-primary{% endif %}"{% if '//' in a.href and site.domain not in a.href %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ a.label }}</a>{% endfor %}
    </div>
  </div>
  <div class="wf-card wf-expanded" id="top">
    <div class="wf-title-row" aria-expanded="true">
      <span class="wf-name-block"><h1 class="wf-name site-h">{{ hero.heading | safe }}</h1></span>
      <svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <div class="wf-body">
      {%- if hero.lede %}<p class="site-words">{{ hero.lede | priceTokens | safe }}</p>{% endif %}
      {%- if hero.actionNote %}<div class="wf-meta site-note">{{ hero.actionNote }}</div>{% endif %}
    </div>
  </div>
  {%- for b in blocks or [] %}
  {%- set _t = b.heading or b.videoName or b.eyebrow or 'More' %}
  <div class="wf-card wf-expanded">
    <div class="wf-title-row" aria-expanded="true">
      <span class="wf-name-block"><h2 class="wf-name site-h">{{ _t | safe }}</h2></span>
      {%- if b.eyebrow and b.heading %}<span class="wf-activity">{{ b.eyebrow }}</span>{% endif %}
      <svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <div class="wf-body">{{ blockBody(b, site.domain) }}</div>
  </div>
  {%- endfor %}
</div>
</div></div>

{%- elif _mode == 'settings' %}
{#- ── SETTINGS: the Settings page's groups (templates/dashboard_settings.html). -#}
<div class="settings-col">
  <div class="wfo-group site-group" id="top" style="margin-bottom:14px;">
    <div class="wfo-group-head wfo-group-head--fixed" aria-expanded="true">
      <h1 class="wfo-group-title site-h">{{ hero.heading | safe }}</h1>
      <span class="wfo-group-extra">{% if hero.eyebrow %}<span class="site-group-label">{{ hero.eyebrow }}</span>{% endif %}</span>
    </div>
    <div class="wfo-group-body">
      {%- if hero.lede %}<p class="site-words">{{ hero.lede | priceTokens | safe }}</p>{% endif %}
      {{ actionGroup(hero.actions, site.domain) }}
      {%- if hero.actionNote %}<div class="wf-meta site-note">{{ hero.actionNote }}</div>{% endif %}
    </div>
  </div>
  {%- for b in blocks or [] %}
  <div class="wfo-group site-group" style="margin-bottom:14px;">
    {%- if b.type != 'raw' or b.heading %}
    <div class="wfo-group-head wfo-group-head--fixed" aria-expanded="true">
      <h2 class="wfo-group-title site-h">{{ (b.heading or b.videoName or b.eyebrow or 'More') | safe }}</h2>
      <span class="wfo-group-extra">{% if b.eyebrow and b.heading %}<span class="site-group-label">{{ b.eyebrow }}</span>{% endif %}<svg class="wf-expand-chevron" width="16" height="10" viewBox="0 0 12 7" fill="none" aria-hidden="true" style="transform:rotate(180deg)"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
    </div>
    {%- endif %}
    <div class="wfo-group-body">{{ blockBody(b, site.domain) }}</div>
  </div>
  {%- endfor %}
  {%- if seoBody %}
  <div class="wfo-group site-group" style="margin-bottom:14px;">
    <div class="wfo-group-head wfo-group-head--fixed" aria-expanded="true"><h2 class="wfo-group-title site-h">More detail</h2></div>
    <div class="wfo-group-body"><div class="site-words">{{ seoBody | priceTokens | safe }}</div></div>
  </div>
  {%- endif %}
</div>

{%- else %}
{#- ── A GUIDE: a Record (templates/workflow/submission_detail.html). -#}
<div class="site-record">
  <div class="site-rec-top">
    <img src="/assets/logos/quickler-logo.svg" alt="" width="152" height="36" class="site-rec-logo">
  </div>
  <div class="site-rec-meta">
    <div>{{ hero.eyebrow or 'Quickler guide' }}</div>
    <div>Quickler guide · {{ site.company }}</div>
  </div>

  <div class="card site-rec-title" id="top">
    <h1 class="site-h site-rec-h1">{{ hero.heading | safe }}</h1>
    {%- if hero.lede %}<div class="site-rec-ref">{{ hero.lede | priceTokens | safe }}</div>{% endif %}
    {%- if _ledePanel %}
    <div class="site-rec-label">IN SHORT</div>
    <div class="site-words">{{ _ledePanel.html | priceTokens | safe }}</div>
    {%- endif %}
    {{ actionGroup(hero.actions, site.domain) }}
    {%- if hero.actionNote %}<div class="wf-meta site-note">{{ hero.actionNote }}</div>{% endif %}
  </div>

  {%- if _todo %}
  <div class="card site-todo">
    <div class="site-todo-head"><span class="site-todo-title">{{ _todo.heading or 'To do list' }}</span></div>
    <div class="sm-issues-list">
    <div class="site-todo-body">{{ _todo.html | priceTokens | safe }}</div>
    </div>
  </div>
  {%- endif %}

  {%- if blocks and blocks | length %}
  <div class="card">
  {%- for b in blocks %}
    <details class="sm-section-group" open>
      <summary class="site-sec-head"><span class="sm-group-label">{{ (b.heading or b.videoName or b.eyebrow or 'More') | safe }}</span></summary>
      <div class="site-sec-body">{{ blockBody(b, site.domain) }}</div>
    </details>
  {%- endfor %}
  </div>
  {%- endif %}

  <div class="card">
    <div class="sm-answers-scroll">
    {%- for ap in articlePanels or [] %}
    {%- if ap.kind != 'lede' and ap.kind != 'takeaways' and ap.kind != 'faq' %}
    <details class="sm-section-group" id="part-{{ loop.index }}" open>
      <summary class="site-sec-head"><span class="sm-group-label">{{ (ap.heading or ap.eyebrow or 'More') | safe }}</span>{% if ap.eyebrow and ap.heading %}<span class="site-group-label">{{ ap.eyebrow }}</span>{% endif %}</summary>
      <table class="sm-normal-tab" style="width:100%;border-collapse:collapse;font-size:0.9rem;table-layout:fixed;"><tbody>
      {%- for r in ap.html | priceTokens | qaRows %}
        <tr class="sm-answer-row" style="border-bottom:1px solid rgba(0,0,0,0.06);">
          <td class="sm-d1" style="padding:8px 32px 8px 32px;vertical-align:top;">
            {%- if r.q %}<div class="sm-answer-q" style="display:flex;align-items:baseline;gap:10px;color:var(--ink,#0d1a3a);font-size:0.85rem;font-weight:500;opacity:0.95;"><h3 class="site-q">{{ r.q | safe }}</h3></div>{% endif %}
            <div class="sm-answer-v" style="margin-top:2px;overflow-wrap:anywhere;color:var(--ink-soft,#6b7280);font-size:0.85rem;">
              <div class="sm-longval sm-prose-answer site-answer" style="margin-top:4px;width:var(--ans-w, 89.75%);margin-left:auto;font-size:var(--note-size);color:var(--ink-soft);line-height:var(--note-line);text-align:left;">{{ r.a | safe }}</div>
            </div>
          </td>
        </tr>
      {%- endfor %}
      </tbody></table>
    </details>
    {%- endif %}
    {%- endfor %}
    </div>
  </div>

  {%- if _faq %}
  {#- The questions people ask, drawn as the Record's WhatsApp transcript, open. -#}
  <div class="card site-transcript">
    <div class="site-sec-head"><span class="sm-group-label">{{ _faq.heading or 'Questions' }}</span><span class="site-group-label">Transcript</span></div>
    <div class="wa-scroll site-wa">
    {%- for r in _faq.html | priceTokens | qaRows %}
      {%- if r.q %}<div class="wa-row wa-you wa-tail"><div class="wa-bubble"><div class="wa-text">{{ r.q | striptags }}</div></div></div>{% endif %}
      <div class="wa-row wa-bot wa-tail"><div class="wa-bubble"><div class="wa-text">{{ r.a | safe }}</div></div></div>
    {%- endfor %}
    </div>
  </div>
  {%- endif %}

  {%- if relatedLinks and relatedLinks | length %}
  <div class="card">
    <div class="site-sec-head"><span class="sm-group-label">Related guides</span></div>
    <div class="site-tiles">
    {%- for r in relatedLinks %}<a class="rec-tile site-tile" href="{{ r.href }}"><span class="row-main"><span class="row-title">{{ r.label }}</span>{% if r.blurb %}<span class="row-meta site-tile-words">{{ r.blurb }}</span>{% endif %}</span></a>{% endfor %}
    </div>
  </div>
  {%- endif %}
</div>
{%- endif %}

{%- set rel = relatedClusters[page.fileSlug] %}
{%- if rel and not hideRelated %}
<div class="card">
  <div class="site-sec-head"><span class="sm-group-label">Related Checks</span><span class="site-group-label">{{ rel.label }}</span></div>
  <div class="site-tiles">
  {%- for it in rel.related %}<a class="rec-tile site-tile" href="{{ it.href }}"><span class="row-main"><span class="row-title">{{ it.title }}</span></span></a>{% endfor %}
  </div>
</div>
{%- endif %}

{%- if seoBody and not articlePanels and _mode == 'checks' %}
<div class="card site-more"><div class="site-sec-head"><span class="sm-group-label">More detail</span></div><div class="site-words">{{ seoBody | priceTokens | safe }}</div></div>
{%- endif %}

{%- if content %}
<div class="card site-content">{{ content | safe }}</div>
{%- endif %}

  </div>
</section>
</main>
{% include "partials/footer.njk" %}

{#- Structured data (JSON-LD), generated from content already on the page so it
    can never drift from what the reader sees. Organization + WebSite are emitted
    on every story page (site identity for Google's knowledge panel and AI
    crawlers). FAQPage is emitted only when an articlePanels FAQ block exists
    (parsed from its <h3>/<p> pairs) -> FAQ rich results. Article is emitted for
    guide pages (those with articlePanels) -> Article rich results. A page can
    still override with its own seo.jsonld in the head. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Quickler",
  "legalName": "{{ site.company }}",
  "url": "{{ site.domain }}",
  "logo": "{{ site.domain }}/assets/icons/apple-touch-icon.png",
  "email": "{{ site.email }}",
  "description": "Quickler is a WhatsApp-native platform for inspections, audits and compliance records. Any team builds its own Checks and the person on the job answers in WhatsApp by text, voice note or photo, producing a structured, timestamped report automatically. No app to install and no login for the person on the job. Used by care homes, nurseries, schools, universities and estates, cleaning firms and field-services trades. UK-first.",
  "foundingLocation": {"@type": "Country", "name": "Scotland"},
  "founder": {"@type": "Person", "name": "Philip Ross"},
  "sameAs": ["{{ site.linkedin }}"]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Quickler",
  "applicationCategory": "BusinessApplication",
  "applicationSubCategory": "Inspection, audit and compliance software",
  "operatingSystem": "WhatsApp (any device), web dashboard",
  "url": "{{ site.domain }}",
  "description": "A WhatsApp-native inspection, audit and compliance tool. Teams build their own Checks; the person on the job answers questions in WhatsApp by text, voice note or photo, and a structured report is produced automatically. No app to install, no login for the person on the job. For care homes, nurseries, schools, universities and estates, cleaning firms and field-services trades.",
  "offers": {
    "@type": "Offer",
    "price": "75",
    "priceCurrency": "GBP",
    "description": "Seventy-five pounds a month for each phone number on the account, after a 14-day free trial with everything unlocked and no card needed to start. Reports, the dashboard, sharing and downloads are free for everyone else."
  },
  "publisher": {"@type": "Organization", "name": "Quickler", "url": "{{ site.domain }}"}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Quickler",
  "url": "{{ site.domain }}"
}
</script>
{#- VideoObject for every video block on the page. Without this Google reports
    "Discovered videos: 0" -- the lite facade shows a thumbnail, not a <video>/
    <iframe> the crawler recognises, so a VideoObject is the only signal that a
    real video lives here. name/description fall back to the block's own
    heading/text, then to sensible site defaults, so a text-free video block
    (e.g. the homepage hero video) still emits valid schema. -#}
{%- for b in blocks %}
{%- if b.type == "video" and b.video %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "{{ (b.videoName or b.heading or seo.title or 'Quickler demo') | striptags }}",
  "description": "{{ (b.videoDescription or b.text or seo.description or 'A Quickler product demonstration: field compliance captured over WhatsApp and turned into a report automatically.') | striptags }}",
  "thumbnailUrl": ["https://i.ytimg.com/vi/{{ b.video }}/maxresdefault.jpg", "https://i.ytimg.com/vi/{{ b.video }}/hqdefault.jpg"],
  {#- uploadDate must be full ISO 8601 WITH a timezone offset. A bare
      "YYYY-MM-DD" trips Google's "missing a time zone" / "invalid datetime"
      warnings, so always emit date + time + offset. -#}
  "uploadDate": "{{ b.videoUploadDate or '2026-07-06T09:00:00+01:00' }}",
  "contentUrl": "https://www.youtube.com/watch?v={{ b.video }}",
  "embedUrl": "https://www.youtube-nocookie.com/embed/{{ b.video }}",
  "publisher": {
    "@type": "Organization",
    "name": "Quickler",
    "logo": { "@type": "ImageObject", "url": "{{ site.domain }}/assets/icons/apple-touch-icon.png" }
  }
}
</script>
{%- endif %}
{%- endfor %}
{%- if articlePanels %}
{%- set faqLd = articlePanels | faqSchema %}
{%- if faqLd %}
<script type="application/ld+json">
{{ faqLd | safe }}
</script>
{%- endif %}
{%- set articleLd = seo | articleSchema %}
{%- if articleLd %}
<script type="application/ld+json">
{{ articleLd | safe }}
</script>
{%- endif %}
{%- endif %}

