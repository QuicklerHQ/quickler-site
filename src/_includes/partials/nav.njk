<nav aria-label="Primary">
  <a href="/" class="nav-name">
    <img src="/assets/logos/quickler-logo.svg" alt="quickler" width="179" height="42">
  </a>
  <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" onclick="var o=document.querySelector('nav').classList.toggle('nav-open');document.body.classList.toggle('nav-page-open',o);this.setAttribute('aria-expanded',o);this.textContent=o?'Close':'Menu'">Menu</button>
  <div class="nav-menu">
    {%- for link in nav.links %}
    <a href="{{ link.href }}">{% if link.new %}<span class="nav-new">NEW!</span>{% endif %}{{ link.label }}</a>
    {%- endfor %}
    <a href="{{ nav.login.href }}" class="nav-login">{{ nav.login.label }}</a>
    <a href="{{ nav.cta.href }}" class="nav-cta-pill" style="background: linear-gradient(90deg, #2F6BFF, #7C3AED 55%, #F43F8C) !important;">
      <span>{{ nav.cta.label }}</span>
    </a>
  </div>
</nav>
