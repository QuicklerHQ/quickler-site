<div class="qs" data-qs>{% for p in uptime.parts %}<div class="qs-part"><div class="qs-top"><div><div class="qs-name">{{ p.name }}</div><div class="qs-what">{{ p.what }}</div></div><div class="qs-now {{ 'is-up' if p.up_now else 'is-down' }}">{{ 'Working' if p.up_now else 'Down' }}</div></div><div class="qs-nums">{% for n in p.nums %}<div class="qs-n"><b>{{ n.pct }}%</b><span>{{ n.label }}</span></div>{% endfor %}</div></div>{% endfor %}<div class="qs-wait">Counted since July 2026, when testing moved to its own server. Copied from UptimeRobot every hour; figures last changed {{ uptime.updated | ukTime }}.</div></div>
