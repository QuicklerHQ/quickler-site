<footer>
  {%- if footerCta %}
  <div class="footer-cta-zone">
    <p class="footer-cta-heading">{{ footerCta.heading }}</p>
    <p class="footer-cta-sub">{{ footerCta.sub | safe }}</p>
    <div class="footer-cta-actions">
      {%- for a in footerCta.actions %}
      <a href="{{ a.href }}" class="{{ a.class }}">{{ a.label }}</a>
      {%- endfor %}
    </div>
  </div>
  <div class="footer-rule"></div>
  {%- endif %}
  {#- Columns like Basecamp's and HEY's footers (Philip 5 Nov 2026: "tidy that up"). -#}
  <div class="site-foot-cols">
    <div class="site-foot-col"><div class="site-foot-head">Quickler</div>
      <a href="/pages/features.html">Features</a><a href="/pages/how-it-works.html">How it works</a><a href="/pages/pricing.html">Pricing</a><a href="/pages/before-and-after.html">Before and after</a><a href="/pages/any-phone.html">Works on any phone</a><a href="/moving-to-quickler/">Moving to Quickler</a><a href="/yes/">Can it do that? Yes</a><a href="/pages/security.html">Security and data</a></div>
    <div class="site-foot-col"><div class="site-foot-head">Company</div>
      <a href="/pages/about.html">About</a><a href="/believe/">Principles</a><a href="/admire/">Companies we admire</a><a href="/reliable/">Reliable</a><a href="/new/">What's new</a><a href="/pages/customers.html">Customers</a><a href="/press/">Press</a><a href="mailto:{{ site.email }}">{{ site.email }}</a><a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></div>
    <div class="site-foot-col"><div class="site-foot-head">Help</div>
      <a href="/pages/faq.html">FAQs</a><a href="/pages/help/index.html">Support</a><a href="/learn/">Learn</a><a href="/status/">Status</a><a href="/pages/guides.html">Guides</a><a href="/pages/services.html">Use cases</a><a href="/pages/workflows-regions.html">Regions</a><a href="/pages/sitemap.html">Sitemap</a></div>
    <div class="site-foot-col"><div class="site-foot-head">Legal</div>
      <a href="/pages/legal.html">Legal</a><a href="/pages/privacy.html">Privacy</a><a href="/your-data/">Your data</a><a href="/pages/terms.html">Terms</a><a href="/pages/customer-terms.html">Customer terms</a><a href="/pages/dpa.html">DPA</a><a href="/pages/cookies.html">Cookies</a><a href="#" data-cookie-settings>Cookie settings</a></div>
  </div>
  <p class="site-foot-small">© {{ site.company }} 2026 · <a href="https://find-and-update.company-information.service.gov.uk/company/{{ site.companyNo }}" target="_blank" rel="noopener noreferrer">Company No. {{ site.companyNo }}</a> · ICO {{ site.ico }} · <a href="#top">Back to top ↑</a> · <span class="site-version">v{{ release.shown or site.version }}</span></p>
</footer>
{#- HEY's floating button, bottom right, once the page has scrolled (Philip
    5 Nov 2026 12:18: "this appears as soon as you start scrolling on any page"). -#}
<a class="hey-float" href="https://app.quickler.co/signup" aria-hidden="true" tabindex="-1">Try Quickler free</a>
<script>(function(){var b=document.querySelector('.hey-float');if(!b)return;function f(){b.classList.toggle('hey-float-on',window.scrollY>240)}addEventListener('scroll',f,{passive:true});f();})();</script>

