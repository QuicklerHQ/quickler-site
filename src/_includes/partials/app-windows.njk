{#- REAL APP WINDOWS (Philip 5 Nov 2026: "use the real one", "make these
    things actually work"). Each home feature is a live window of the app,
    drawn from Philip's own demo walk (2 Nov 2026, Demo Firm, Site Safety
    Inspection, Bell Street, London). Every word, number and photo comes from
    src/_data/demoWalk.json, built from that walk; nothing is made up.
    Behaviour: /js/app-windows.js. Styles: css/appsite.css ("aw-").
    Macros: appWin(feature), waMsg(m), recCard(c), todoCard(), recHead(). -#}
{%- set _dw = demoWalk %}
{%- set _ph = '/assets/photos/demo/photo-' %}

{%- macro pic(n, cls, eager) -%}
<picture><source srcset="{{ _ph }}{{ n }}.webp" type="image/webp"><img class="{{ cls }}" src="{{ _ph }}{{ n }}.jpg" alt="{{ _dw.photos[n - 1].caption }}"{% if not eager %} loading="lazy"{% endif %} decoding="async"></picture>
{%- endmacro %}

{%- macro photoBtn(n, cls) -%}
<button type="button" class="aw-ph {{ cls }}" data-aw-photo="{{ n }}" aria-label="Open photo: {{ _dw.photos[n - 1].caption }}">{{ pic(n, 'aw-thumb-img' if cls == 'aw-ph-thumb' else 'wa-photo') }}</button>
{%- endmacro %}

{%- macro ticks() -%}<span class="wa-ticks" aria-hidden="true"><svg width="16" height="11" viewBox="0 0 16 11"><path d="M11.1.6 4.9 7.6 2 4.9l-.9.9 3.8 3.7L12 1.5zM14.9.6 8.7 7.6l-.8-.7-.9.9 1.7 1.7L15.8 1.5z" fill="currentColor"/></svg></span>{%- endmacro %}

{%- macro waTime(m) -%}<span class="wa-time">{{ m.time }}{% if m.from == 'you' %} {{ ticks() }}{% endif %}</span>{%- endmacro %}

{%- macro voice(m, open) -%}
{#- The dashboard's own voice note (quickler-dashboard workflow/_wa_voice.html), as is. -#}
<div class="wa-voice" data-wa-voice>
  <div class="wa-vav" aria-hidden="true"><img src="/assets/photos/philip-face.jpg" alt=""><span class="wa-vmic"><svg width="11" height="14" viewBox="0 0 12 16"><rect x="3.4" y="0.6" width="5.2" height="9.4" rx="2.6" fill="currentColor"/><path d="M1.2 7.4a4.8 4.8 0 0 0 9.6 0M6 12.2v3.2" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg></span></div>
  <button type="button" class="wa-vspeed" aria-label="Playback speed 1 times. Press to change."><span class="wa-vspeed-pill">1&times;</span></button>
  <button type="button" class="wa-vplay" aria-label="Play voice message">
    <svg class="wa-vplay-on" width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path fill="currentColor" d="M3 1.6v18.8c0 .9 1 1.4 1.7.9l14-9.4c.6-.4.6-1.4 0-1.8l-14-9.4C4 .2 3 .7 3 1.6z"/></svg>
    <svg class="wa-vplay-off" width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><rect x="3" y="1.5" width="4.6" height="19" rx="1.2" fill="currentColor"/><rect x="12.4" y="1.5" width="4.6" height="19" rx="1.2" fill="currentColor"/></svg>
  </button>
  <div class="wa-vbody">
    <div class="wa-vwave" role="slider" tabindex="0" aria-label="Voice message position" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="0:00"><span class="wa-vdot" aria-hidden="true"></span></div>
    <div class="wa-vlen" aria-hidden="true">&nbsp;</div>
  </div>
  <audio class="wa-audio" preload="auto" data-src="/assets/audio/demo/{{ (m.id | int) - 1 }}.m4a"></audio>
</div>
<div class="aw-heard">{{ m.transcript }}</div>
{%- endmacro %}

{%- macro waMsg(m, opts) -%}
{%- set o = opts or {} %}
<div class="wa-row {{ 'wa-bot' if m.from == 'bot' else 'wa-you' }}{% if m.tail %} wa-tail{% endif %}">
  <div class="wa-bubble{% if m.kind == 'voice' %} aw-vb{% endif %}">
  {%- if m.kind == 'text' %}
    <div class="wa-text{% if m.long and not o.full %} aw-long{% endif %}"{% if m.long and not o.full %} data-aw-long{% endif %}>{{ m.html | safe }}</div>
    {%- if m.long and not o.full %}<button type="button" class="aw-more" aria-expanded="false">Read more</button>{% endif %}
    {{ waTime(m) }}
  {%- elif m.kind == 'voice' %}
    {{ voice(m, o.open) }}
    {{ waTime(m) }}
  {%- elif m.kind == 'photo' %}
    {{ photoBtn(m.n, '') }}
    {{ waTime(m) }}
  {%- elif m.kind == 'album' %}
    <div class="wa-album">{% for n in m.ns %}<div class="wa-album-cell">{{ photoBtn(n, 'aw-ph-album') }}</div>{% endfor %}</div>
    {{ waTime(m) }}
  {%- elif m.kind == 'location' %}
    <div class="wa-pin"><div class="wa-pin-map" aria-hidden="true"><img class="wa-pin-tile" src="/assets/photos/demo/map/16-32736-21787.png" alt="" loading="lazy" width="256" height="256" style="left:calc(50% + -349px);top:calc(50% + -242px)"><img class="wa-pin-tile" src="/assets/photos/demo/map/16-32736-21788.png" alt="" loading="lazy" width="256" height="256" style="left:calc(50% + -349px);top:calc(50% + 14px)"><img class="wa-pin-tile" src="/assets/photos/demo/map/16-32737-21787.png" alt="" loading="lazy" width="256" height="256" style="left:calc(50% + -93px);top:calc(50% + -242px)"><img class="wa-pin-tile" src="/assets/photos/demo/map/16-32737-21788.png" alt="" loading="lazy" width="256" height="256" style="left:calc(50% + -93px);top:calc(50% + 14px)"><span class="wa-pin-osm">&copy; OpenStreetMap</span><svg class="wa-pin-icon" width="30" height="30" viewBox="0 0 24 24"><path fill="#e53935" d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg></div>
      <div class="wa-pin-body"><div class="wa-pin-addr">{{ m.address }}</div><div class="wa-pin-coords">{{ m.coords }}</div></div></div>
    {{ waTime(m) }}
  {%- elif m.kind == 'report' %}
    <a class="aw-linkcard" href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ" target="_blank" rel="noopener"><span class="aw-linkcard-t">{{ _dw.check }} &ndash; {{ _dw.firm }}</span><span class="aw-linkcard-d">app.quickler.co</span></a>
    <div class="wa-text">Here is your report:
<a class="wa-link" href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ" target="_blank" rel="noopener">https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ</a></div>
    {{ waTime(m) }}
  {%- endif %}
  </div>
</div>
{%- endmacro %}

{%- macro waPanel(msgs, cls) -%}
<div class="aw-wa {{ cls }}">
  <div class="wa-topbar"><div class="wa-avatar"><img src="/assets/icons/apple-touch-icon.png" alt="" width="40" height="40"></div><div class="wa-title"><div class="wa-name">Quickler</div><div class="wa-status">WhatsApp messages</div></div></div>
  <div class="wa-scroll aw-scroll" tabindex="0" aria-label="WhatsApp messages">
    <div class="wa-day">Friday 6 November 2026</div>
    {%- for m in msgs %}{{ waMsg(m) }}{% endfor %}
  </div>
</div>
{%- endmacro %}

{%- macro answerCls(c) -%}{{ 'aw-yes' if c == 'yes' else ('aw-no' if c == 'no' else ('aw-na' if c == 'na' else 'aw-text')) }}{%- endmacro %}

{%- macro recRow(r) -%}
<div class="aw-row{% if r.cls == 'na' %} aw-row-na{% endif %}">
  <div class="aw-q">{{ r.label }}</div>
  <div class="aw-a {{ answerCls(r.cls) }}">{{ r.answer }}</div>
  {%- for n in r.notes %}<p class="aw-note">{{ n }}</p>{% endfor %}
  {%- if r.photos | length %}<div class="aw-thumbs">{% for n in r.photos %}{% set f = _dw.photos[n - 1].fault %}<span class="aw-thumb">{{ photoBtn(n, 'aw-ph-thumb') }}{% if f == 'yes' %}<span class="aw-mark aw-mark-fault" aria-hidden="true">!</span>{% elif f == 'no' %}<span class="aw-mark aw-mark-ok" aria-hidden="true">&#10003;</span>{% endif %}</span>{% endfor %}</div>{% endif %}
</div>
{%- endmacro %}

{%- macro recCard(c) -%}
<section class="aw-card">
  {%- if c.title %}<div class="aw-card-head"><h3 class="aw-card-t">{{ c.title }}</h3>{% if c.badge %}<span class="aw-badge aw-badge-{{ c.badgeCls }}">{{ c.badge }}</span>{% endif %}</div>{% endif %}
  {%- for n in c.notes %}<p class="aw-note aw-sec-note">{{ n }}</p>{% endfor %}
  {%- for r in c.rows %}{{ recRow(r) }}{% endfor %}
</section>
{%- endmacro %}

{%- macro todoCard() -%}
<section class="aw-card aw-todo">
  <h3 class="aw-todo-h"><svg width="18" height="16" viewBox="0 0 24 22" aria-hidden="true"><path d="M12 1.5 1 20.5h22z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 8v6M12 16.6v1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> To do list</h3>
  <div class="aw-todo-tiles">
    <div class="aw-tile aw-tile-score"><span class="aw-tile-n">{{ _dw.score }}%</span><span class="aw-prog"><span style="width:{{ _dw.score }}%"></span></span></div>
    <div class="aw-tile aw-tile-faults"><span class="aw-tile-n">{{ _dw.todo | length }}</span></div>
  </div>
  <ol class="aw-todo-list">{% for t in _dw.todo %}<li>{{ t }}</li>{% endfor %}</ol>
  <div class="aw-todo-foot"><button type="button" class="aw-copy" data-aw-copy>Copy</button></div>
</section>
{%- endmacro %}

{%- macro recHead() -%}
<section class="aw-card aw-head">
  <div class="aw-firm">{{ _dw.firm }}</div>
  <div class="aw-head-t">{{ _dw.check }}</div>
  <div class="aw-head-m">{{ _dw.when }}<br>{{ _dw.who }}</div>
</section>
<section class="aw-card aw-where">
  <h2 class="aw-where-t">{{ _dw.address }} <span>&middot; Shared view-only link</span></h2>
  <div class="aw-loc">
    <div><div class="aw-cap">Location</div><div class="aw-addr">{% for l in _dw.addressLines %}{{ l }}<br>{% endfor %}</div></div>
    <div class="aw-coords">{{ _dw.coords }}<br>{{ _dw.plus }}</div>
  </div>
  <div class="aw-weather">
    <div class="aw-w-big"><svg width="30" height="22" viewBox="0 0 30 22" aria-hidden="true"><path d="M8 20h15a6 6 0 0 0 .6-12A8 8 0 0 0 8.2 9.6 5.3 5.3 0 0 0 8 20z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span><b>{{ _dw.weather.temp }}&deg;C</b><small>{{ _dw.weather.cond }}</small></span></div>
    <ul class="aw-w-list">
      <li>&darr;{{ _dw.weather.min }}&deg; &uarr;{{ _dw.weather.max }}&deg;</li>
      <li>Wind {{ _dw.weather.wind }}</li>
      <li>Humidity {{ _dw.weather.hum }}</li>
      <li>Sunrise {{ _dw.weather.sunrise }} &middot; Sunset {{ _dw.weather.sunset }}</li>
    </ul>
  </div>
</section>
{%- endmacro %}

{%- macro winBar() -%}

{%- endmacro %}

{%- macro appWin(kind) -%}
<div class="aw aw-{{ kind }}" data-aw="{{ kind }}">
  {{ winBar() }}
  <div class="aw-body">
  {#- THE REAL PROD PAGE (Philip 5 Nov 2026 16:43: "just show prod as it is and
      it becomes when it updates"). Once site.demoBase is set, each window is the
      dashboard's own /demo page (whichever Record is the website demo), opened
      at its part. The pictures below are only the stop-gap until then. -#}
  {%- set _live = {'chat': '#messages', 'done': '#messages', 'photos': '#photo-1', 'todo': '#todo'} %}
  {%- if site.demoBase and _live[kind] %}
    <div class="aw-live-wrap"><iframe class="aw-live" src="{{ site.demoBase }}/demo?embed=1{{ _live[kind] }}" title="Quickler's demo report, live" loading="lazy" referrerpolicy="strict-origin"></iframe><div class="aw-hover-hint">Double click or tap to use it</div></div>
  {%- elif kind == 'chat' %}
    {{ waPanel(_dw.chat, 'aw-wa-tall') }}
  {%- elif kind == 'place' %}
    {#- Before and after: the real WhatsApp list message, then the same message
        after some answers (Philip 5 Nov 2026 15:16, his words exactly). -#}
    <div class="aw-ba2">
      <div class="aw-ba2-col"><div class="aw-ba2-h">Before</div><div class="aw-ba2-chat"><div class="wa-row wa-bot wa-tail"><div class="wa-bubble"><div class="wa-text"><b>Location ⌖</b> ▸ Share your pin<br>What you should cover:<br><b>Job</b><br><b>Audit</b><br><b>People</b> ▸ Personnel · Supervisor<br><b>Activities</b> ▸ Current · Describe<br><b>Arrangements</b> ▸ Plan · RAMS · Induction · Lone work<br><b>Emergency</b> ▸ Sign-off · Exits · First aid<br><b>Health</b> ▸ Stock · COSHH · Last review · Incidents<br><b>Height Work</b> ▸ Assessment · Edge · Harness<br><b>Scaffold</b> ▸ Assessment · Tag · Access<br><b>Toolbox</b> ▸ Completed · Evidence · 1.1<br><b>Follow-up</b> ▸ Comments · Actions<br><b>Supervisor</b> ▸ Name · Signatures</div><span class="wa-time">10:02</span></div></div></div></div>
      <div class="aw-ba2-arrow" aria-hidden="true"><svg width="56" height="32" viewBox="0 0 56 32"><defs><linearGradient id="awg" x1="0" x2="1"><stop offset="0" stop-color="#2F6BFF"/><stop offset=".55" stop-color="#7C3AED"/><stop offset="1" stop-color="#F43F8C"/></linearGradient></defs><path d="M2 16h44M34 4l14 12-14 12" stroke="url(#awg)" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <div class="aw-ba2-col"><div class="aw-ba2-h">After</div><div class="aw-ba2-chat"><div class="wa-row wa-bot wa-tail"><div class="wa-bubble"><div class="wa-text">✅ 10 OK · 8 N/A · ❌4 to fix<br>⌖ ✓ · Photos 50<br><br>What still needs covered:<br><b>Audit</b><br><b>Activities</b> ▸ Current<br><b>Arrangements</b> ▸ Plan · Lone work<br><b>Emergency</b> ▸ Exits · First aid<br><b>Health</b> ▸ Last review · Incidents<br><b>Height Work</b> ▸ Edge · Harness<br><b>Toolbox</b> ▸ Evidence · 1.1<br><b>Follow-up</b> ▸ Actions<br><b>Supervisor</b> ▸ Name · Signatures<br><br>✅ ✓ Job · ✓ People<br><br>⚠️ Details, fix, &amp; photos❌:<br>Health → Stock✗<br>Follow-up → Comments✗</div><span class="wa-time">10:31</span></div></div></div></div>
    </div>
  {%- elif kind == 'snap' %}
    {#- Taking a photo on site, three phone screens (Philip 5 Nov 2026 16:08): the chat upright,
        then the phone turned sideways; 2 sits above 3. Styles: css/snap.css. -#}
    <div class="aw-snap snap-v2"><figure class="snap-ph snap-portrait"><span class="snap-shot"><img src="/assets/photos/app/snap-1-chat.jpg?v=2" alt="The Quickler chat in WhatsApp, with the camera button ringed" width="606" height="1280" loading="lazy"><span class="snap-tap" style="left:77.89%;top:96.72%" aria-hidden="true"><span class="snap-tap-ring"></span><span class="snap-tap-label">Tap</span></span></span><figcaption>1. Tap the camera</figcaption></figure><div class="snap-arrow snap-arrow-r" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><defs><linearGradient id="snapg" x1="0" x2="1"><stop offset="0" stop-color="#2F6BFF"/><stop offset=".55" stop-color="#7C3AED"/><stop offset="1" stop-color="#F43F8C"/></linearGradient></defs><path d="M3 12h16M13 5l7 7-7 7" stroke="url(#snapg)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div class="snap-col"><figure class="snap-ph snap-landscape"><span class="snap-shot"><img src="/assets/photos/app/snap-2-camera.jpg?v=2" alt="The WhatsApp camera, phone turned sideways, pointed at a digger" width="1280" height="606" loading="lazy"><span class="snap-tap" style="left:84.77%;top:50.50%" aria-hidden="true"><span class="snap-tap-ring"></span><span class="snap-tap-label">Tap</span></span></span><figcaption>2. Take the photo</figcaption></figure><div class="snap-arrow snap-arrow-d" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M3 12h16M13 5l7 7-7 7" stroke="url(#snapg)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div><figure class="snap-ph snap-landscape"><span class="snap-shot"><img src="/assets/photos/app/snap-3-send.jpg?v=2" alt="The digger photo ready to send to Quickler in WhatsApp" width="1280" height="606" loading="lazy"><span class="snap-tap" style="left:96.25%;top:91.75%" aria-hidden="true"><span class="snap-tap-ring"></span><span class="snap-tap-label">Tap</span></span></span><figcaption>3. Send it</figcaption></figure></div></div>
{%- elif kind == 'done' %}
    {{ waPanel(_dw.chat, '') }}
  {%- elif kind == 'photos' %}
    <div class="aw-real aw-scroll aw-report" tabindex="0" data-aw-y="1109"><img src="/assets/photos/real/report.webp" alt="The real Quickler report from the demo walk, opened at a question with its photo" width="1170" height="12168" loading="lazy"><div class="aw-hs-layer"><span class="aw-hs aw-dl" style="left:86.282%;top:0.296%;width:3.974%;height:0.382%"><button type="button" class="aw-dl-btn" aria-label="Download" aria-expanded="false"></button><span class="aw-dl-menu" hidden><a href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ/pdf" target="_blank" rel="noopener">PDF</a><a href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ/record.csv" target="_blank" rel="noopener">CSV</a><a href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ/record.xlsx" target="_blank" rel="noopener">Excel file</a><a href="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ?dl=html" target="_blank" rel="noopener">Web page</a></span></span><button type="button" class="aw-hs" data-aw-copytext="https://app.quickler.co/view-only-share-link/spMOr8VyLnjiKZewjk_udZXKDeWIgxUAy1Mm43K9nhQ" style="left:91.282%;top:0.247%;width:4.872%;height:0.468%" aria-label="Copy shareable link"></button><a class="aw-hs" href="https://www.google.com/maps/search/?api=1&amp;query=56.4636%2C-2.9735" target="_blank" rel="noopener" style="left:7.564%;top:2.650%;width:10.000%;height:0.777%" aria-label="Open the location on a map"></a><a class="aw-hs" href="https://www.google.com/maps/search/?api=1&amp;query=56.4636%2C-2.9735" target="_blank" rel="noopener" style="left:44.872%;top:2.971%;width:15.513%;height:0.234%" aria-label="Open the location on a map"></a><a class="aw-hs" href="https://www.google.com/maps/search/?api=1&amp;query=56.4636%2C-2.9735" target="_blank" rel="noopener" style="left:44.231%;top:3.205%;width:16.154%;height:0.234%" aria-label="Open the 