---json
{
  "pagination": { "data": "featureVideos", "size": 1, "alias": "v" },
  "permalink": "/videos/{{ v.slug }}/index.html",
  "eleventyExcludeFromCollections": true
}
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ v.title }}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="https://quickler.co{{ v.page }}">
<meta http-equiv="refresh" content="0; url={{ v.page }}">
</head>
<body><p>This video now lives at <a href="{{ v.page }}">{{ v.page }}</a>.</p></body>
</html>
